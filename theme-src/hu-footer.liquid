<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h3>{{ section.settings.t14 }}</h3>
        <p style="max-width:32ch">{{ section.settings.t15 }}</p>
      </div>
      <div>
        <h3>{{ section.settings.t16 }}</h3>
        <ul>
          {%- if section.settings.menu_briefings != blank and section.settings.menu_briefings.links.size > 0 -%}
            {%- for link in section.settings.menu_briefings.links -%}
          <li><a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
          <li>{{ section.settings.r1 }}</li>
          <li>{{ section.settings.r2 }}</li>
          <li>{{ section.settings.r3 }}</li>
          <li>{{ section.settings.r4 }}</li>
          <li>{{ section.settings.r5 }}</li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h3>{{ section.settings.t17 }}</h3>
        <ul>
          {%- if section.settings.menu_company != blank and section.settings.menu_company.links.size > 0 -%}
            {%- for link in section.settings.menu_company.links -%}
          <li><a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
          <li>{{ section.settings.r6 }}</li>
          <li>{{ section.settings.r7 }}</li>
          <li>{{ section.settings.r8 }}</li>
          <li>{{ section.settings.r9 }}</li>
          <li>{{ section.settings.r10 }}</li>
          {%- endif -%}
        </ul>
      </div>
      <div>
        <h3>{{ section.settings.t18 }}</h3>
        <ul>
          <li>{{ section.settings.r11 }}</li>
          <li>{{ section.settings.r12 }}</li>
          <li>{{ section.settings.r13 }}</li>
        </ul>
      </div>
    </div>
    <p class="disclaimer">{{ section.settings.t19 }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_briefings",
      "label": "Briefings column menu (optional)",
      "info": "Pick a menu from Online Store → Navigation to control this column from admin. Leave empty to use the built-in links below."
    },
    {
      "type": "link_list",
      "id": "menu_company",
      "label": "Company column menu (optional)",
      "info": "Pick a menu from Online Store → Navigation to control this column from admin. Leave empty to use the built-in links below."
    },
    {
      "type": "liquid",
      "id": "r1",
